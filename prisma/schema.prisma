// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Professor {
  id        Int        @id @default(autoincrement()) @map("id_professor")
  nome      String
  email     String     @unique
  senha     String
  tipo      String
  materiais Material[]

  @@map("professores")
}

model Favorito {
  id         Int      @id @default(autoincrement()) @map("id_favorito")
  idMaterial Int      @map("id_material")
  material   Material @relation(fields: [idMaterial], references: [id])

  @@map("favoritos")
}

model Disciplina {
  id        Int      @id @default(autoincrement()) @map("id_disciplina")
  nome      String
  descricao String?
  createdAt DateTime @default(now())

  materiais Material[]
}

model Material {
  id             Int      @id @default(autoincrement()) @map("id_material")
  titulo         String
  descricao      String
  url            String
  status         String
  motivoRejeicao String?
  createdAt      DateTime @default(now())

  professorId  Int
  disciplinaId Int

  professor  Professor  @relation(fields: [professorId], references: [id])
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])

  favoritos Favorito[]
}
