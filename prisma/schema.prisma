// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Professor{
  idProfessor String @id @default(uuid()) @map("id_professor")
  nome String
  email String
  senha String
  tipo String

  @@map("professores")
}

model Favorito{
  idFavorito String @id @default(uuid()) @map("id_favorito")
  idMaterial String @map("id_material")
  material Material @relation(fields: [idMaterial], references: [id])

  @@map("favoritos")
}